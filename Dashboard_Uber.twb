      <aliases enabled='yes' />
      <column caption='Hour' datatype='integer' name='[Calculation_6376201907347456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [pickup_time])' />
      </column>
      <column caption='Trip Duration' datatype='integer' name='[Calculation_6376201907437569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [pickup_time], [drop_time])' />
      </column>
      <column caption='Revenue per KM' datatype='real' name='[Calculation_6376201907556354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fare_amount] / [distance_km]' />
